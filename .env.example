# Required
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
DEEPINFRA_API_KEY=your_deepinfra_api_key

# Optional — send alerts to a chat/channel
TELEGRAM_CHAT_ID=your_chat_id

# AI model (default: meta-llama/Meta-Llama-3.1-70B-Instruct)
DEEPINFRA_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct

# Scan settings
SCAN_INTERVAL=120              # seconds between scans
MIN_GRYPTZ_SCORE=60            # minimum score to send alert
MIN_LIQUIDITY_USD=5000         # USD liquidity floor
MIN_VOLUME_1H_USD=10000        # USD 1h volume floor
MIN_BUY_RATIO=0.55             # 55%+ buys in last 1h
